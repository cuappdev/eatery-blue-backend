{
  "name": "eatery-blue-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/src/server.js",
    "start:prod": "NODE_ENV=production node dist/src/server.js",
    "start:dev": "NODE_ENV=development node dist/src/server.js",
    "dev": "NODE_ENV=development nodemon -x tsx src/server.ts",
    "lint": "eslint '{src,test}/**/*.ts' --fix",
    "format": "prettier --write '{src,test}/**/*.ts'",
    "scrape": "tsx prisma/scraper.ts",
    "scrape:scheduled": "SCHEDULED_MODE=true node dist/prisma/scraper.js",
    "studio": "prisma studio",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "notifications": "tsx prisma/notificationService.ts",
    "notifications:scheduled": "SCHEDULED_MODE=true node dist/prisma/notificationService.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuappdev/eatery-blue-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cuappdev/eatery-blue-backend/issues"
  },
  "homepage": "https://github.com/cuappdev/eatery-blue-backend#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true,
    "fsevents@2.3.3": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "@prisma/client@7.10.1": true,
    "@prisma/adapter-pg@7.10.1": true
  }
}
